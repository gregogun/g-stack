{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/no-underscore-dangle": "off"
  },
  "env": {
    "builtin": true,
    "browser": false,
    "es2022": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".output",
    ".claude/worktrees"
  ]
}
